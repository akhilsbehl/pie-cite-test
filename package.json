{
  "name": "pie-cite-test",
  "version": "0.1.0",
  "description": "Pi extension that tests whether cited web sources support explicit claims",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/pie-cite-test.mjs",
  "types": "./dist/pie-cite-test.d.mts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {"node": ">=22.19.0"},
  "pi": {"extensions": ["./dist/pie-cite-test.mjs"]},
  "scripts": {
    "build": "tsdown --clean && mv dist/index.mjs dist/pie-cite-test.mjs && mv dist/index.d.mts dist/pie-cite-test.d.mts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.80.10",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@types/node": "26.1.1",
    "tsdown": "0.22.13",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "peerDependencies": {"@earendil-works/pi-coding-agent": "^0.80.10 || ^0.81.0"}
}
